#Extract Email Contents
Sub extractEmail()
    Dim OutApp As New Outlook.Application
    Dim OutNameSpace As Namespace, OutFolder As Folder, OutItem As Object, OutMail As MailItem
    Dim r As Integer
    
    Set OutNameSpace = OutApp.GetNamespace("MAPI")
    Set OutFolder = OutNameSpace.GetDefaultFolder(olFolderInbox).Folders("Macro")
    
    r = 1
    For Each OutItem In OutFolder.Items
        Set OutMail = OutItem
        r = r + 1
        With Worksheets("Sheet1")
            'Extract Email Sent Datetime
            Range("A" & r).Value = OutMail.SentOn
            'Extract Email EW Memo & Add /
            Range("B" & r).Value = Left(OutMail.Subject, 11)
            Range("B" & r).Value = Left(Range("B" & r), 4) & "/" & Mid(Range("B" & r), 5, 7)
            'Extract EW Memo & Add /
            Range("C" & r).Value = Mid(OutMail.Body, InStr(1, OutMail.Body, "EW Memo") + 9, 11)
            Range("C" & r).Value = Left(Range("C" & r), 4) & "/" & Mid(Range("C" & r), 5, 7)
            'Extract Product Memo & Add /
            Range("D" & r).Value = Mid(OutMail.Body, InStr(1, OutMail.Body, "Product Memo") + 15, 11)
            Range("D" & r).Value = Left(Range("D" & r), 4) & "/" & Mid(Range("D" & r), 5, 7)
            'Extract Symptoms
            Range("E" & r).Value = Mid(OutMail.Body, InStr(1, OutMail.Body, "Symptoms") + 11, InStr(1, OutMail.Body, "Attached") - (InStr(1, OutMail.Body, "Symptoms") + 11))
            Range("E" & r) = Trim(Replace(Range("E" & r), vbCrLf, ""))
        End With
    Next OutItem
    
End Sub
