    Dim objMail As Object
    Dim strTo As String
    Dim strSubject, vendor As String
    Dim table1 As Range
    Dim i As Integer
'    Application.ScreenUpdating = False
    
'Set email properties
    vendor = Worksheets("Receipt").Range("C2")
    If vendor = "Bolttech Digital Insurance / Apple Asia" Then
        strTo = ""
    Else
        strTo = ""
    End If
    
    strSubject = "PO Invoice (" & Worksheets("Receipt").Range("C2") & ") " & Date
    'Debug.Print strSubject
    i = Worksheets("Receipt").Range("A999").End(xlUp).Row
    'Debug.Print i
    Set table1 = Worksheets("Receipt").Range(Worksheets("Receipt").Cells(1, 1), Worksheets("Receipt").Cells(i, 8))
    
'Create Outlook object
    Set objOutlook = CreateObject("Outlook.Application")
    Set objMail = objOutlook.CreateItem(0)

'Set email recipients, subject, and body
    With objMail
        .To = strTo
        .Cc = ""
        .Subject = strSubject
        .Display
        
        Set WordDoc = .GetInspector.WordEditor

        WordDoc.Range.Delete

        WordDoc.Content.InsertBefore "Dear Finance Team," & vbCrLf & vbCrLf & _
                                   "Attached are the invoices for payment. Thanks!" & vbCrLf & vbCrLf

        table1.Copy
        WordDoc.Range(WordDoc.Content.End - 1).Paste

        WordDoc.Content.InsertAfter vbCrLf & "Best regards," & vbCrLf & _
                                            "Bolttech" & vbCrLf & _
                                            "Jimmy Yim"
    End With

'Clean up
    Set objMail = Nothing
    Set objOutlook = Nothing
    
End Sub
